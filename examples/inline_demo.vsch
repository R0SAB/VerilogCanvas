// ===== BEGIN HDL 0d89e277556747a1a8bac84d35f9363c_0 "Top-level declarations" =====
typedef enum logic [1:0] { MOD_AM = 0, MOD_FM = 1 } modulation_t;

// ===== END HDL 0d89e277556747a1a8bac84d35f9363c_0 =====

// ===== BEGIN HDL 0d89e277556747a1a8bac84d35f9363c_1 "mode_control" =====
// Prototype mode decoding; MOD_AM is declared in the top level.
input logic [1:0] modulation;
input logic enable;
output logic mode;

assign mode = enable && (modulation == MOD_AM);

// ===== END HDL 0d89e277556747a1a8bac84d35f9363c_1 =====
